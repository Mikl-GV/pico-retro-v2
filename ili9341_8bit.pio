;
; 8-битная параллельная запись в ILI9341 (интерфейс 8080).
; out pins: D0..D7 (8 бит), side-set: /WR (1 бит).
; out_shift: shift_right=true (OSR[7:0] → старший байт пикселя первым).
; Автопулл после 32 бит.
;
.program ili9341_8bit_write
.side_set 1

.wrap_target
    out pins, 8  side 0  [1]
    nop           side 1  [1]
.wrap
